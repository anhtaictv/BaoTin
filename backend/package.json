{
  "name": "baotin-backend",
  "version": "1.23.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "gen:keys": "tsx scripts/gen-jwt-keys.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed": "tsx prisma/seed/index.ts",
    "seed:demo-accounts": "tsx prisma/seed/seed-demo-accounts.ts",
    "seed:demo-reports": "tsx prisma/seed/run-seed-demo-reports.ts",
    "seed:traffic-accidents": "tsx prisma/seed/run-seed-traffic-accidents.ts",
    "seed:locked-citizen": "tsx prisma/seed/run-seed-locked-citizen.ts",
    "crawl:rss": "tsx src/crawler/runCrawler.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "exifr": "^7.1.3",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jose": "^5.9.3",
    "minio": "^8.0.1",
    "multer": "^2.2.0",
    "otplib": "^12.0.1",
    "prisma": "^5.20.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.11.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
