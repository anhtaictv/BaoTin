// Báo Tin — Giai đoạn 1 schema.
// PostGIS geometry columns use Unsupported(...) — see docs/adr/0001-postgis-geometry-via-unsupported-raw-sql.md.
// All geometry reads/writes happen via parameterized $queryRaw/$executeRaw in src/geo and prisma/seed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportSource {
  citizen
  social_media

  @@map("report_source")
}

enum ReportUrgency {
  emergency
  normal

  @@map("report_urgency")
}

enum ReportStatus {
  pending
  verifying
  confirmed_true
  confirmed_false

  @@map("report_status")
}

enum TrustLevel {
  verified_press
  unverified_social

  @@map("trust_level")
}

enum OfficerRole {
  officer
  senior_officer
  admin

  @@map("officer_role")
}

/// Gates password-based officer login (auth/registration.service.ts) — self-registered
/// officers start `pending` and cannot log in until an admin approves them. Existing
/// seed/admin-provisioned officers default `approved` so their OTP login stays unaffected.
enum OfficerApprovalStatus {
  pending
  approved
  rejected

  @@map("officer_approval_status")
}

enum TrafficAccidentAlertStatus {
  pending
  confirmed
  dismissed

  @@map("traffic_accident_alert_status")
}

enum ExtractionRequestStatus {
  pending
  sent
  fulfilled
  rejected

  @@map("extraction_request_status")
}

/// "general" = the one shared channel every officer account can read/write ("chat chung"),
/// used to notify information across all units. "district" = one private channel per đơn vị
/// (District) between that district's assigned officers and admin/senior_officer ("chat riêng
/// từng đơn vị từ tài khoản admin") — access is gated in chat.service.ts via the same
/// districtScope rules as everything else district-scoped (signals.service.ts, officerReports).
enum ChatChannelType {
  general
  district

  @@map("chat_channel_type")
}

/// Citizen accounts. phoneNumberEnc/fullNameEnc are AES-256-GCM ciphertext (iv:tag:ciphertext,
/// base64-joined) — see src/crypto/aesGcm.ts. phoneHash is a deterministic HMAC-SHA256 blind
/// index used only for equality lookup (OTP request/verify) — see docs/adr and src/crypto/phoneBlindIndex.ts.
model User {
  id                String    @id @default(uuid())
  phoneNumberEnc    String    @map("phone_number_enc")
  phoneHash         String    @unique @map("phone_hash")
  fullNameEnc       String?   @map("full_name_enc")
  verifiedAt        DateTime? @map("verified_at")
  isAnonymousPublic Boolean   @default(true) @map("is_anonymous_public")
  createdAt         DateTime  @default(now()) @map("created_at")
  /// Set automatically the moment a 4th of this user's citizen reports gets marked
  /// confirmed_false by an officer (reportLifecycle.service.ts's checkAndLockAbusiveUser) —
  /// null means never locked. Blocks new normal reports only, not SOS (createEmergencyReport
  /// never checks this — CLAUDE.md: SOS prioritizes stability over feature richness). No
  /// automatic expiry by design — lifting it is a deliberate admin action, not a timer.
  lockedAt          DateTime? @map("locked_at")

  /// Username/password registration (auth/registration.service.ts) — a citizen who's only
  /// ever used OTP has all 6 of these null. Registering fills them in on the *same* row
  /// (matched by phoneHash) rather than creating a duplicate account.
  username          String?   @unique
  passwordHash      String?   @map("password_hash")
  cccdNumberEnc     String?   @map("cccd_number_enc")
  addressEnc        String?   @map("address_enc")
  /// MinIO object keys (not URLs), same non-URL-storage pattern as ReportAttachment.fileUrl.
  cccdFrontPhotoUrl String?   @map("cccd_front_photo_url")
  cccdBackPhotoUrl  String?   @map("cccd_back_photo_url")

  /// FCM device token registered by the citizen app after login (POST /auth/device-token) —
  /// null means the app hasn't registered one yet (never opened, or push permission denied).
  /// FirebaseNotificationSender looks this up by targetId at send time.
  fcmToken          String?   @map("fcm_token")

  reports       Report[]
  otpChallenges OtpChallenge[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Officer accounts. Same encrypted-field + blind-index pattern as User.
model Officer {
  id             String      @id @default(uuid())
  phoneNumberEnc String      @map("phone_number_enc")
  phoneHash      String      @unique @map("phone_hash")
  fullNameEnc    String      @map("full_name_enc")
  unitName       String?     @map("unit_name")
  role           OfficerRole @default(officer)
  createdAt      DateTime    @default(now()) @map("created_at")

  /// Username/password self-registration (auth/registration.service.ts) — a citizen-facing
  /// counterpart to WebAccount, but self-service and gated by approvalStatus instead of
  /// admin-provisioned. `approved` default keeps every existing seed/OTP-only officer
  /// (including admin) logging in exactly as before; only rows created via the new
  /// self-registration endpoint start at `pending`. Deliberately no CCCD photo columns here
  /// (product decision: officer registration takes a text CCCD number only, unlike citizen).
  username       String?     @unique
  passwordHash   String?     @map("password_hash")
  cccdNumberEnc  String?     @map("cccd_number_enc")
  addressEnc     String?     @map("address_enc")
  approvalStatus OfficerApprovalStatus @default(approved) @map("approval_status")

  /// FCM device token registered by the officer app after login (POST /auth/device-token) —
  /// same as User.fcmToken.
  fcmToken       String?     @map("fcm_token")

  assignments        OfficerDistrictAssignment[]
  assignedReports     Report[]                    @relation("AssignedOfficer")
  statusChanges       ReportStatusHistory[]
  otpChallenges       OtpChallenge[]
  refreshTokens       RefreshToken[]
  auditLogEntries     AdminAuditLog[]
  cameraExtractionRequests CameraExtractionRequest[]
  webAccount          WebAccount?
  wantedNotices       WantedNotice[]
  assignedTrafficAccidentAlerts  TrafficAccidentAlert[] @relation("AssignedTrafficAccidentAlert")
  confirmedTrafficAccidentAlerts TrafficAccidentAlert[] @relation("ConfirmedTrafficAccidentAlert")
  chatMessages        ChatMessage[]
  broadcastAlerts     OfficerBroadcastAlert[]

  @@map("officers")
}

/// Official wanted notices ("lệnh truy nã") — posted only by senior_officer/admin (see
/// role gating in api/wanted/wantedNotices.routes.ts), visible to any authenticated account
/// (citizen or officer), system-wide (no district scoping — a wanted subject isn't confined
/// to one xã/phường). The photo itself carries all identifying info by product decision, so
/// there's deliberately no name/crime/etc. column here.
model WantedNotice {
  id         String   @id @default(uuid())
  /// MinIO object key, not a URL — resolved to a presigned GET URL at read time, same
  /// pattern as ReportAttachment.fileUrl.
  photoUrl   String   @map("photo_url")
  postedById String   @map("posted_by_id")
  createdAt  DateTime @default(now()) @map("created_at")

  postedBy Officer @relation(fields: [postedById], references: [id])

  @@map("wanted_notices")
}

/// dashboard-web-react — username/password login for the 102 xã/phường web management
/// portal, deliberately a SEPARATE table from `officers` (not a password column bolted onto
/// it) so a password-hash compromise stays isolated from the table the OTP flow and every
/// other officer record depends on. Same underlying person as `officers` (1-1 via
/// officerId) — logging in here still issues the exact same JWT (issueTokenPair with
/// subjectType "officer"), so district scoping/role gating downstream needs zero changes.
/// The Flutter officer app's OTP login is completely unaffected by this table's existence.
model WebAccount {
  id                 String    @id @default(uuid())
  officerId          String    @unique @map("officer_id")
  /// Snapshot of the officer's phone number at account-provisioning time — a login
  /// identifier, not kept in sync if the officer's real number changes later.
  username           String    @unique
  /// scrypt, format "saltHex:hashHex" — see crypto/passwordHash.ts.
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  /// TOTP 2FA (SECURITY.md §3 "cân nhắc bắt buộc 2FA... vì quyền truy cập dữ liệu nhạy cảm
  /// hơn tài khoản dân thường"). totpSecret is AES-256-GCM ciphertext via the SAME
  /// src/crypto/aesGcm.ts helper used for phone/name — never a second encryption scheme.
  /// totpEnabled stays false while a secret is merely staged (setup called, confirm not yet
  /// called) — see webAccountAuth.service.ts's setupTotp/confirmTotp.
  totpSecret  String?  @map("totp_secret")
  totpEnabled Boolean  @default(false) @map("totp_enabled")

  officer Officer @relation(fields: [officerId], references: [id])

  @@map("web_accounts")
}

/// Administrative ward/commune (xã/phường, post-2025 merger) — the geo-matching unit.
/// boundary is Geometry(MultiPolygon,4326) — see docs/adr/0002.
model District {
  id         String   @id @default(uuid())
  maXa       String?  @unique @map("ma_xa")
  tenXa      String   @map("ten_xa")
  parentName String?  @map("parent_name")
  loai       String?
  dtichKm2   Float?   @map("dtich_km2")
  danSo      Int?     @map("dan_so")
  boundary   Unsupported("geometry(MultiPolygon,4326)")
  createdAt  DateTime @default(now()) @map("created_at")

  assignments           OfficerDistrictAssignment[]
  reports               Report[]
  signals               SocialMediaSignal[]
  cameras               Camera[]
  emergencyContacts     EmergencyContact[]
  trafficAccidentAlerts TrafficAccidentAlert[]
  chatMessages          ChatMessage[]
  broadcastAlerts       OfficerBroadcastAlert[]

  @@map("districts")
}

/// Giai đoạn 3 "Danh bạ khẩn cấp tự động theo vị trí". districtId null = liên hệ mặc định/
/// toàn quốc (vd. 113/114/115) — dùng khi địa bàn xác định được chưa có liên hệ riêng nào.
model EmergencyContact {
  id          String   @id @default(uuid())
  districtId  String?  @map("district_id")
  contactType String   @map("contact_type") // 'police' | 'medical' | 'fire'
  name        String
  phoneNumber String   @map("phone_number")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  district District? @relation(fields: [districtId], references: [id])

  @@index([districtId, contactType])
  @@map("emergency_contacts")
}

model OfficerDistrictAssignment {
  id         String   @id @default(uuid())
  officerId  String   @map("officer_id")
  districtId String   @map("district_id")
  isActive   Boolean  @default(true) @map("is_active")

  officer  Officer  @relation(fields: [officerId], references: [id])
  district District @relation(fields: [districtId], references: [id])

  @@unique([officerId, districtId])
  @@index([districtId, isActive])
  @@map("officer_district_assignments")
}

/// Citizen reports — the central table. Never mixed with SocialMediaSignal in any query/view.
model Report {
  id                    String        @id @default(uuid())
  source                ReportSource  @default(citizen)
  userId                String?       @map("user_id")
  category              String?
  urgency               ReportUrgency @default(normal)
  description           String?
  voiceNoteUrl          String?       @map("voice_note_url")
  location              Unsupported("geometry(Point,4326)")
  locationSource        String?       @map("location_source") // 'exif' | 'device_gps' | 'manual_pin'
  districtId            String?       @map("district_id")
  assignedOfficerId     String?       @map("assigned_officer_id")
  status                ReportStatus  @default(pending)
  createdAt             DateTime      @default(now()) @map("created_at")
  verifiedAt            DateTime?     @map("verified_at")
  responseTimeSeconds   Int?          @map("response_time_seconds")
  // Idempotency key for citizen submission retries (offline queue / flaky network) — see
  // reportLifecycle.service.ts createCitizenReport. Null for emergency reports (no retry queue).
  clientRequestId       String?       @unique @map("client_request_id")

  user            User?                  @relation(fields: [userId], references: [id])
  district        District?              @relation(fields: [districtId], references: [id])
  assignedOfficer Officer?               @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  attachments     ReportAttachment[]
  statusHistory   ReportStatusHistory[]
  officialCaseLinks OfficialCaseLink[]
  cameraExtractionRequests CameraExtractionRequest[]

  @@index([districtId])
  // status/assignedOfficerId are filtered directly (officerReports listReports, dashboard
  // groupBy); (source, createdAt) covers the WHERE clause common to every dashboardStats
  // query (getOverview/getVolumeTrend/getReportLocations/... all filter source='citizen'
  // AND created_at >= X first).
  @@index([status])
  @@index([assignedOfficerId])
  @@index([source, createdAt])
  @@map("reports")
}

model ReportAttachment {
  id          String   @id @default(uuid())
  reportId    String   @map("report_id")
  fileUrl     String   @map("file_url")
  fileType    String?  @map("file_type")
  exifGpsLat  Float?   @map("exif_gps_lat")
  exifGpsLng  Float?   @map("exif_gps_lng")
  createdAt   DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id])

  @@index([reportId])
  @@map("report_attachments")
}

/// Open-source-intelligence signals (crawler, Giai đoạn 2). Deliberately has NO status/officer
/// columns — this table never enters the officer verification workflow (see CONTEXT.md "Signal").
model SocialMediaSignal {
  id               String     @id @default(uuid())
  sourceName       String?    @map("source_name")
  sourceUrl        String?    @unique @map("source_url")
  trustLevel       TrustLevel @map("trust_level")
  summary          String?
  rawSnippet       String?    @map("raw_snippet")
  districtId       String?    @map("district_id")
  detectedCategory String?    @map("detected_category")
  publishedAt      DateTime?  @map("published_at")
  crawledAt        DateTime   @default(now()) @map("crawled_at")
  duplicateOfId    String?    @map("duplicate_of")

  district    District?           @relation(fields: [districtId], references: [id])
  duplicateOf SocialMediaSignal?  @relation("SignalDuplicate", fields: [duplicateOfId], references: [id])
  duplicates  SocialMediaSignal[] @relation("SignalDuplicate")

  @@index([districtId])
  @@index([crawledAt])
  @@map("social_media_signals")
}

model ReportStatusHistory {
  id         String       @id @default(uuid())
  reportId   String       @map("report_id")
  oldStatus  ReportStatus? @map("old_status")
  newStatus  ReportStatus  @map("new_status")
  changedBy  String?       @map("changed_by")
  /// Officer's note at this status change — API_SPEC.md's PATCH /officer/reports/:id/status
  /// already accepted this in the request body, but nothing ever persisted it until now.
  note       String?
  changedAt  DateTime      @default(now()) @map("changed_at")

  report  Report   @relation(fields: [reportId], references: [id])
  officer Officer? @relation(fields: [changedBy], references: [id])

  @@index([reportId, changedAt])
  @@map("report_status_history")
}

model OfficialCaseLink {
  id             String   @id @default(uuid())
  reportId       String   @map("report_id")
  externalCaseId String?  @map("external_case_id")
  linkedAt       DateTime @default(now()) @map("linked_at")

  report Report @relation(fields: [reportId], references: [id])

  @@index([reportId])
  @@map("official_case_links")
}

/// Short-lived OTP challenges. Code stored as HMAC hash only, self-expiring — see src/crypto/otpHash.ts.
/// subjectType distinguishes citizen vs officer since they're separate tables — same
/// no-hard-FK-on-either-side pattern as RefreshToken below (an officer's id must never
/// be forced into a column FK'd to `users`, and vice versa).
model OtpChallenge {
  id           String    @id @default(uuid())
  subjectType  String    @map("subject_type") // 'user' | 'officer'
  userId       String?   @map("user_id")
  officerId    String?   @map("officer_id")
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at")
  attemptCount Int       @default(0) @map("attempt_count")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id])
  officer Officer? @relation(fields: [officerId], references: [id])

  @@index([userId, expiresAt])
  @@index([officerId, expiresAt])
  @@map("otp_challenges")
}

/// Refresh tokens — hash stored only, rotated on every use (old row deleted/superseded on refresh).
/// subjectType distinguishes citizen vs officer since they're separate tables.
model RefreshToken {
  id           String    @id @default(uuid())
  tokenHash    String    @unique @map("token_hash")
  subjectType  String    @map("subject_type") // 'user' | 'officer'
  userId       String?   @map("user_id")
  officerId    String?   @map("officer_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id])
  officer Officer? @relation(fields: [officerId], references: [id])

  @@map("refresh_tokens")
}

/// Addition beyond the original 9-table DATABASE_SCHEMA.md — satisfies SECURITY.md §1.4
/// ("Admin có audit log riêng cho mọi thao tác nhạy cảm"). See plan ADR notes.
model AdminAuditLog {
  id         String   @id @default(uuid())
  officerId  String   @map("officer_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  officer Officer @relation(fields: [officerId], references: [id])

  @@map("admin_audit_log")
}

/// v1.1 — registered security cameras. Originally location + managing-unit contact only (no
/// recognition of any kind) — product decision (anh, 2026-07-23) added the scoped traffic-
/// accident detector below, so that boundary now only holds for identity: still never face
/// recognition or cross-camera person tracking (see TrafficAccidentAlert).
model Camera {
  id                  String   @id @default(uuid())
  name                String
  location            Unsupported("geometry(Point,4326)")
  managingUnitName    String?  @map("managing_unit_name")
  managingUnitContact String?  @map("managing_unit_contact")
  districtId          String?  @map("district_id")
  createdAt           DateTime @default(now()) @map("created_at")

  /// Compass bearing (0-359, 0 = Bắc) the camera lens faces, and its field-of-view width in
  /// degrees — lets the officer UI draw a "cone" showing what the camera can actually see,
  /// instead of just a dot that might be pointed away from the incident. Both nullable:
  /// real cameras registered without this data still show as a plain marker.
  directionDegrees    Int?     @map("direction_degrees")
  fovDegrees          Int?     @map("fov_degrees")

  district              District?                 @relation(fields: [districtId], references: [id])
  extractionRequests    CameraExtractionRequest[]
  trafficAccidentAlerts TrafficAccidentAlert[]

  @@index([districtId])
  @@map("cameras")
}

/// Object-detection-only traffic accident alert (YOLO person/vehicle detection + collision/
/// deceleration heuristic + license-plate OCR — see the paired Python worker). Deliberately
/// excludes anything from the same codebase that does face embedding, person re-id, or
/// cross-camera tracking — that stays out of Báo Tin entirely (biometric surveillance needs
/// its own legal basis, a decision this table does not revisit). Human-in-the-loop still
/// applies: every alert starts `pending` — nothing here is ever auto-filed as a confirmed
/// incident, same principle as citizen reports (CLAUDE.md #3).
model TrafficAccidentAlert {
  id                   String                     @id @default(uuid())
  cameraId             String                     @map("camera_id")
  districtId           String?                    @map("district_id")
  assignedOfficerId    String?                     @map("assigned_officer_id")
  /// Comma-separated OCR reads (usually 1-2 vehicles per accident) — a scalar array column
  /// isn't worth the extra type surface for a field never queried/filtered on individually.
  plateNumbers         String?                    @map("plate_numbers")
  thumbnailUrl         String?                    @map("thumbnail_url")
  status               TrafficAccidentAlertStatus @default(pending)
  detectedAt           DateTime                   @default(now()) @map("detected_at")
  confirmedAt          DateTime?                  @map("confirmed_at")
  confirmedByOfficerId String?                    @map("confirmed_by_officer_id")

  camera             Camera    @relation(fields: [cameraId], references: [id])
  district            District? @relation(fields: [districtId], references: [id])
  assignedOfficer     Officer?  @relation("AssignedTrafficAccidentAlert", fields: [assignedOfficerId], references: [id])
  confirmedByOfficer  Officer?  @relation("ConfirmedTrafficAccidentAlert", fields: [confirmedByOfficerId], references: [id])

  @@index([districtId])
  @@index([cameraId])
  @@map("traffic_accident_alerts")
}

/// v1.1 — an administrative *request* to a camera's managing unit, not a result. No column
/// ever holds returned footage; status only tracks the request's paperwork progress
/// (pending/sent/fulfilled/rejected), never video content or any recognition outcome.
///
/// `groupId` (added later) ties together the rows an officer creates in one action when
/// selecting several cameras along a route (e.g. tracing a vehicle's likely path after an
/// accident) — it is still N independent administrative requests, one per camera's managing
/// unit, each still asking a human there to pull footage for a time window. There is no
/// cross-camera person/vehicle recognition anywhere in this system: CLAUDE.md non-negotiable
/// #8 rules that out as a deliberate, procedural limitation (biometric tracking needs its own
/// legal basis and belongs in a police-specific operational system), not a technical gap.
model CameraExtractionRequest {
  id             String                  @id @default(uuid())
  reportId       String                  @map("report_id")
  cameraId       String                  @map("camera_id")
  requestedBy    String                  @map("requested_by")
  timeRangeStart DateTime                @map("time_range_start")
  timeRangeEnd   DateTime                @map("time_range_end")
  note           String?
  groupId        String?                 @map("group_id")
  status         ExtractionRequestStatus @default(pending)
  createdAt      DateTime                @default(now()) @map("created_at")

  report          Report  @relation(fields: [reportId], references: [id])
  camera          Camera  @relation(fields: [cameraId], references: [id])
  requestedOfficer Officer @relation(fields: [requestedBy], references: [id])

  @@index([reportId])
  @@index([groupId])
  @@index([cameraId])
  @@map("camera_extraction_requests")
}

/// Liên lạc giữa các đơn vị ("chat chung" + "chat riêng từng đơn vị từ tài khoản admin") —
/// bottom-nav "Chat" tab in mobile-app-officer, purely for cross-unit notification/coordination.
/// Deliberately separate from every citizen-facing table (Report, SocialMediaSignal, ...): a
/// chat message is never evidence and never enters the report verification workflow.
model ChatMessage {
  id          String          @id @default(uuid())
  channelType ChatChannelType @map("channel_type")
  /// Null when channelType=general (the one shared channel). Required when channelType=
  /// district — which đơn vị (District) this message belongs to.
  districtId  String?         @map("district_id")
  senderId    String          @map("sender_id")
  content     String
  createdAt   DateTime        @default(now()) @map("created_at")

  sender   Officer   @relation(fields: [senderId], references: [id])
  district District? @relation(fields: [districtId], references: [id])

  @@index([channelType, districtId, createdAt])
  @@map("chat_messages")
}

/// Cảnh báo ngược từ cán bộ (Geo-fence Alert, theo địa bàn/phường — không phải bán kính GPS
/// liên tục) — officer/senior_officer/admin phát cảnh báo nhanh tới người dân đang ở trong 1
/// địa bàn. Named apart from `DistrictAlert` (a TS interface in areaAlerts.service.ts for
/// report-density aggregation, unrelated concept) to avoid confusion. Reuses `ReportUrgency`
/// instead of a new severity enum — same emergency/normal vocabulary the rest of the app uses.
model OfficerBroadcastAlert {
  id          String        @id @default(uuid())
  districtId  String        @map("district_id")
  message     String
  urgency     ReportUrgency @default(normal)
  createdById String        @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  district  District @relation(fields: [districtId], references: [id])
  createdBy Officer  @relation(fields: [createdById], references: [id])

  @@index([districtId, createdAt])
  @@map("officer_broadcast_alerts")
}

/// Tra cứu văn bản luật/quy định (AI local qua Ollama, xem legalLookup.service.ts) — corpus
/// nạp thủ công 1 lần từ PDF trong data/legal-corpus/ (prisma/seed/import-legal-corpus.ts),
/// không crawl live. Không tách bảng riêng cho khoản — trích từ fullText bằng regex lúc
/// truy vấn (deterministic, không cần AI).
model LegalDocument {
  id             String   @id @default(uuid())
  title          String
  documentNumber String?  @map("document_number")
  sourceFileName String   @unique @map("source_file_name")
  importedAt     DateTime @default(now()) @map("imported_at")

  articles LegalArticle[]

  @@map("legal_documents")
}

model LegalArticle {
  id              String @id @default(uuid())
  legalDocumentId String @map("legal_document_id")
  articleNumber   Int    @map("article_number")
  title           String
  fullText        String @map("full_text")

  document LegalDocument @relation(fields: [legalDocumentId], references: [id])

  @@unique([legalDocumentId, articleNumber])
  @@map("legal_articles")
}
