<?xml version="1.0" encoding="utf-8"?>
<!--
  Vite copies everything under public/ verbatim into dist/ — this file ends up next to
  dist/index.html, which IIS serves from the site's /admin physical subfolder (root is now
  landing/index.html, a static Citizen/Officer chooser page — see landing/web.config for the
  /api/* reverse-proxy rule, which lives at the site root since it's shared by /admin,
  /citizen and /officer alike).

  Job: everything under /admin that isn't a real file/folder -> /admin/index.html, so
  react-router's client-side routes (/admin/reports, /admin/accounts, ...) survive a hard
  refresh. Mirrors the same pattern as dashboard-web/web/web.config for /legacy.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReactRouterSpaFallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/admin/index.html" />
        </rule>
      </rules>
    </rewrite>
    <!-- Deliberately no blanket long-lived <clientCache> here — it would apply to index.html
         too and a browser could then hide a redeploy for up to that long. Vite's hashed asset
         filenames (main.[hash].js) already make long caching safe for those specifically;
         tuning that per-extension is a later optimization, not needed for a demo deploy. -->
  </system.webServer>
</configuration>
