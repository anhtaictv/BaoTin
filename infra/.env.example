# --- Postgres (docker-compose + backend/.env must both reference these) ---
POSTGRES_USER=baotin_migrator
POSTGRES_PASSWORD=changeme_migrator_pw
POSTGRES_DB=baotin
# Must match infra/postgres/init/002-app-role.sql — change both together.
APP_DB_PASSWORD=changeme_app_pw

# Owner role connection — used only for `prisma migrate dev/deploy` and seeding.
DATABASE_URL=postgresql://baotin_migrator:changeme_migrator_pw@localhost:5432/baotin
# App runtime connection — least-privilege role, used by the running Express server.
APP_DATABASE_URL=postgresql://baotin_app:changeme_app_pw@localhost:5432/baotin

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_pw
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=baotin-reports
MINIO_PRESIGNED_URL_TTL_SECONDS=900

# --- JWT (RS256, keys generated via `npm run gen:keys`, never commit *.pem) ---
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_TTL_MINUTES=20
JWT_REFRESH_TTL_DAYS=30

# --- Application-layer PII encryption (AES-256-GCM) ---
# 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit a real value. Rotating this key makes existing encrypted rows unreadable.
PII_ENCRYPTION_KEY=
# HMAC key for the deterministic phone_hash blind index (lookup-only, not reversible).
PHONE_BLIND_INDEX_KEY=
# Extra pepper mixed into OTP hashing (optional but recommended).
OTP_HASH_PEPPER=

NODE_ENV=development
PORT=3000
