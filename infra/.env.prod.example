# Production .env for infra/docker-compose.prod.yml — lives ONLY on the VPS (create by copying
# this file to `.env` in the same directory and filling in real values). Never commit the real
# file, never put it in git, never let CI see it — see docs/DEPLOY.md.
#
# Every "baotin.example.vn" below is the SAME domain — replace all of them together.

# --- Caddy / domain (infra/Caddyfile) ---
DOMAIN=baotin.example.vn

# --- GHCR image source (.github/workflows/deploy.yml pushes here) ---
GHCR_OWNER=anhtaictv
# Pin to a specific build if you ever need to roll back; leave unset to always run the latest
# successful deploy.
# IMAGE_TAG=sha-abc1234

# --- Postgres ---
POSTGRES_USER=baotin_migrator
POSTGRES_PASSWORD=
POSTGRES_DB=baotin
# Must match infra/postgres/init/002-app-role.sql — change both together.
APP_DB_PASSWORD=

# Backend runs inside the same Docker network as postgres/minio here — use the service names
# below, NOT localhost (that only works in the dev docker-compose.yml where the backend runs
# on the host directly).
DATABASE_URL=postgresql://baotin_migrator:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/baotin
APP_DATABASE_URL=postgresql://baotin_app:REPLACE_WITH_APP_DB_PASSWORD@postgres:5432/baotin

# --- MinIO ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=baotin-reports
MINIO_PRESIGNED_URL_TTL_SECONDS=900

# --- JWT (RS256) — generate ONCE on the VPS (docs/DEPLOY.md), never regenerate on redeploy ---
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_TTL_MINUTES=20
JWT_REFRESH_TTL_DAYS=30

# --- Application-layer PII encryption — generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required (config/env.ts fails startup otherwise). Never reuse the dev key.
PII_ENCRYPTION_KEY=
PHONE_BLIND_INDEX_KEY=
# Required in production specifically (config/env.ts) — an empty pepper lets a stolen
# otp_challenges table be brute-forced offline.
OTP_HASH_PEPPER=

NODE_ENV=production
PORT=3000

# Single origin — the dashboard is served from the same domain via Caddy path routing
# (infra/Caddyfile), so this is mostly a defense-in-depth belt (also required non-empty by
# config/env.ts in production; mobile apps don't send an Origin header so aren't affected).
CORS_ALLOWED_ORIGINS=https://baotin.example.vn

# --- AI business tasks (crawler summarizer/relevance/dedup, report classifier, heat
# narrative, search interpreter) — leave "none" unless the AI Gateway/a key is set up.
# LLM_PROVIDER=openai defaults OPENAI_BASE_URL to the shared AI Gateway (AI_GATEWAY.md) at
# 127.0.0.1:8080 on this same VPS — set OPENAI_API_KEY=<GATEWAY_API_KEY>.
LLM_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
