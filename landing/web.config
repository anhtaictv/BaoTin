<?xml version="1.0" encoding="utf-8"?>
<!--
  Site root (C:\inetpub\baotin\web.config) — landing/index.html is a static chooser page (no
  client-side routes, no SPA fallback needed here). Owns the two rules that must live at the
  site root: /api/* reverse-proxied to the backend (shared by /admin, /citizen and /officer
  alike), and /baotin-reports/* (the MinIO bucket name) proxied to MinIO — MinIO itself stays
  bound to 127.0.0.1 only (docs/DEPLOY.md §1.4, never exposed directly for security), so
  presigned image URLs need *this* public path to be reachable, matching MINIO_PUBLIC_ENDPOINT
  in backend/.env. Requires the URL Rewrite + Application Request Routing (ARR, "Enable proxy"
  on) IIS modules — see docs/DEPLOY.md.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- SECURITY.md §2.1 "bắt buộc HTTPS, không có endpoint HTTP thuần" — phải đứng
             TRƯỚC 2 rule proxy bên dưới (stopProcessing) để http:// không lọt qua chưa mã hóa. -->
        <rule name="RedirectHttpToHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="ApiReverseProxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:3010/{R:1}" />
        </rule>
        <rule name="MinioReverseProxy" stopProcessing="true">
          <match url="^(baotin-reports/.*)" />
          <action type="Rewrite" url="http://127.0.0.1:9000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <!-- Node/helmet đã có các header này cho /api/*, nhưng /citizen /officer /admin
             /legacy là file tĩnh IIS serve thẳng, không qua Node — phải khai riêng ở đây.
             Không thêm Content-Security-Policy ở đây: Flutter web (CanvasKit) và React đều
             cần CSP khác nhau (wasm-unsafe-eval, worker blob:...), set sai sẽ làm app trắng
             màn hình — để sau, test riêng từng app trước khi khóa CSP toàn site. -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Strict-Transport-Security" value="max-age=15552000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>
    <!-- IIS has no built-in MIME type for .apk — without this, /downloads/*.apk 404s. -->
    <staticContent>
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
    </staticContent>
  </system.webServer>
</configuration>
