<?xml version="1.0" encoding="utf-8"?>
<!--
  Site root (C:\inetpub\baotin\web.config) — landing/index.html is a static chooser page (no
  client-side routes, no SPA fallback needed here). Owns the one rule that must live at the
  site root: /api/* reverse-proxied to the backend, since that path is shared by /admin,
  /citizen and /officer alike. Requires the URL Rewrite + Application Request Routing (ARR,
  "Enable proxy" on) IIS modules — see docs/DEPLOY.md.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ApiReverseProxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:3010/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <!-- IIS has no built-in MIME type for .apk — without this, /downloads/*.apk 404s. -->
    <staticContent>
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
    </staticContent>
  </system.webServer>
</configuration>
