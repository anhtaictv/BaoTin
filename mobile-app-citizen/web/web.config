<?xml version="1.0" encoding="utf-8"?>
<!--
  `flutter build web` copies everything under web/ verbatim into build/web/ — this file ends up
  next to build/web/index.html, served by IIS from /citizen.

  Perf fix (2026-08-10): main.dart.js is ~3.3MB and was being served with no compression and no
  cache header (measured via DevTools trace — TTL 0, no content-encoding), so every single visit
  re-downloaded it in full. <urlCompression> only takes effect if the server's IIS role already
  has the Static/Dynamic Content Compression feature installed — see docs/DEPLOY.md §1.5 for the
  one-time PowerShell step, without it this element is a no-op.

  Cache-Control is scoped to assets/icons only (rarely change, not overwritten between deploys
  the way main.dart.js is) — NOT applied to main.dart.js/index.html, which have no content hash
  in their filename, so a long cache there would hide the next redeploy from returning visitors.
-->
<configuration>
  <system.webServer>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <location path="assets">
      <system.webServer>
        <staticContent>
          <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
        </staticContent>
      </system.webServer>
    </location>
    <location path="icons">
      <system.webServer>
        <staticContent>
          <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
        </staticContent>
      </system.webServer>
    </location>
  </system.webServer>
</configuration>
